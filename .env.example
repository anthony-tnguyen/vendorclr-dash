# Leave everything unset to run against the in-memory demo repository.
# Setting VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY switches getRepository()
# to Supabase and turns on real auth.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Where magic links in outbound emails point. Defaults to
# http://localhost:3000 if unset, which is fine for local dev.
VITE_APP_URL=

# Server-only (no VITE_ prefix - never sent to the browser). Required for the
# vendor upload portal: resolveUploadToken() and uploadDocumentForToken() in
# src/workflows/vendorUploadRequests.ts use it to read/write on behalf of an
# anonymous vendor who has no Supabase session of their own. Also what
# /api/health/ready and getOperationalFailures() (src/server/operations.ts)
# need to reach Supabase. Named VENDORCLEAR_* rather than SUPABASE_* because
# the secret store reserves the SUPABASE_ prefix for managed connections -
# see src/lib/supabase/serverClient.server.ts.
VENDORCLEAR_SUPABASE_URL=
VENDORCLEAR_SERVICE_ROLE_KEY=

# Optional. Without it, "Request updated certificate" still creates the upload
# request and returns the magic link for the admin to copy - it just doesn't
# send real email. See src/workflows/emailSender.ts.
RESEND_API_KEY=

# Optional. Without it, certificate uploads still process, just without
# extraction - a document stays 'uploaded' rather than reaching 'processed'/
# 'needs_review'. See src/workflows/documentExtraction.ts.
ANTHROPIC_API_KEY=

# Optional. Without it, uploads still succeed - malware_scan_status on
# vendor_documents just records 'not_configured' instead of a real result.
# See src/workflows/malwareScanner.ts.
VIRUSTOTAL_API_KEY=

# Optional. A Sentry DSN (not secret - the same value Sentry expects embedded
# in client-side JS). Without it, both src/lib/observability/sentry.client.ts
# and sentry.server.ts no-op: no throw, no build break, nothing sent anywhere.
# VITE_-prefixed (not just server-only) because Sentry DSNs are meant to ship
# in the browser bundle, and this project already reads VITE_-prefixed vars
# from server-only files the same way (see VITE_APP_URL above) - one var,
# read identically by both sides.
VITE_SENTRY_DSN=

# Optional. Build-time release identifier tagged onto every Sentry event and
# /api/health/{live,ready} response. Falls back to "unknown" when unset,
# which is correct for local dev - no CI/CD pipeline sets this yet (Task 13).
# A future deploy step would set it to $GITHUB_SHA before `bun run build`.
VITE_RELEASE_SHA=

# Optional. Where notifyAlert() (src/server/operations.ts) POSTs a firing
# alert's {key, severity, message} as JSON. Without it, a firing alert is
# only logged (level "warn", event "alert_fired_no_provider_configured"),
# never delivered anywhere - this project has no real alert provider
# (Slack/PagerDuty/etc.) wired up yet.
VITE_ALERT_WEBHOOK_URL=
